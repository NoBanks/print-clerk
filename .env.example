# Copy to .env and fill in. Never commit .env.
# Leave everything empty to run fully offline against the local Context MCP emulator.

# Read path: Sanity Context MCP (Dashboard > Context > your MCP endpoint)
# Format: https://api.sanity.io/v1/context/organizations/<organizationId>/mcp/<endpointName>
SANITY_CONTEXT_MCP_URL=
# Organization API token with the Context Viewer role
SANITY_ORGANIZATION_TOKEN=
# Optional, comma separated Knowledge Base ids (they start with "kb")
SANITY_KNOWLEDGE_BASE_IDS=

# Write path: drafts, inquiries and audit events (project API token, Editor role)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_WRITE_TOKEN=

# Studio (studio/ folder)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Optional model, any OpenAI-compatible endpoint. Unset = template writer, and `ask` is disabled.
LLM_BASE_URL=
LLM_API_KEY=
# Optional: unset = first id from GET $LLM_BASE_URL/models
LLM_MODEL=
